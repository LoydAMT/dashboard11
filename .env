# Firebase web app config.
# Console > Project settings > General > Your apps > SDK setup and configuration.
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored; `.env.example` is not. These values are not secrets — a Firebase
# web config is public by design. Access is controlled by database.rules.json,
# not by hiding these.

VITE_FIREBASE_API_KEY=AIzaSyBelUXNrvdtagJeRtAnKp4lq5BIcWKmEQg
VITE_FIREBASE_AUTH_DOMAIN=testononlinedb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=testononlinedb
VITE_FIREBASE_APP_ID=1:132537702254:web:bcb4fba291ba8fe07ed37f

# Realtime Database, NOT Firestore. Must be the full URL including region,
# e.g. https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=https://testononlinedb-default-rtdb.asia-southeast1.firebasedatabase.app

# Which device's status/{id} node drives the live/stale indicator.
VITE_DEVICE_ID=RHW01
