# Firebase web app config.
# Console > Project settings > General > Your apps > SDK setup and configuration.
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored; `.env.example` is not. These values are not secrets — a Firebase
# web config is public by design. Access is controlled by database.rules.json,
# not by hiding these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Realtime Database, NOT Firestore. Must be the full URL including region,
# e.g. https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=

# Firestore archive read endpoint (the readArchive Cloud Function). History
# older than whatever is still in RTDB is fetched from here and merged into
# the same charts — see src/lib/archiveApi.js.
#
# Optional. Leave blank and the app behaves exactly as it did before the
# archive existed: charts simply stop wherever RTDB's retained history stops,
# with no error. Fill it in to see further back than RTDB still holds.
VITE_ARCHIVE_API_URL=https://asia-southeast1-your-project.cloudfunctions.net/readArchive
