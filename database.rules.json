// Realtime Database security rules.
//
// Data flows one way: the logger's service account writes, clients read.
// The Admin SDK bypasses these rules entirely, so denying every client write
// here costs the pusher nothing and removes the whole class of "someone with
// the web config forged a reading" problems.
//
// Multi-device model, all under devices/{deviceId}/. Access is per device,
// checked two ways at every gated node, both required:
//   1. auth.token.firebase.sign_in_provider !== 'anonymous' - not enough by
//      itself. Enabling the Email/Password provider (required for real
//      sign-in to work at all) also enables public self-registration through
//      the identical API, since the client's API key is not a secret - this
//      alone would let anyone who finds it create an account and pass.
//   2. That account is a viewer or operator of this specific device, or a
//      global admin. viewers/ and operators/ are admin-provisioned by hand
//      in the console and never written by the app. Viewer and operator are
//      equivalent for *reading* telemetry - both accepted identically below -
//      but not for commands/: writing to devices/{deviceId}/commands requires
//      operator or admin specifically, a viewer cannot. See that block.
//
// access/{uid}/{deviceId} is a separate, client-readable index of "which
// devices does this account see" - it exists only because Firebase cannot
// query "which devices list my uid" the other way around. It is navigation
// data, not a security decision: the rules below never reference it. It can
// in principle drift from devices/{deviceId}/viewers|operators (an admin
// mirrors both by hand); when it does, the rules below are what actually
// governs access, and the app is expected to treat the resulting
// PERMISSION_DENIED as a normal, handled state, not a crash.
//
// history/ is queried with orderByKey(), which needs no .indexOn - keys are
// always indexed.
{
  "rules": {
    ".read": false,
    ".write": false,

    "devices": {
      "$deviceId": {
        // A session may read its own membership check inputs implicitly via
        // the root.child() calls below; it never reads viewers/operators
        // directly (see those nodes' own rules further down).
        "latest": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": false
        },

        "history": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": false
        },

        "tags": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": false
        },

        "status": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": false
        },

        // Closed to the client both ways - admin-provisioned in the console
        // by hand, read only internally via root.child() from the rules
        // above. A client read here would leak the full member list of a
        // device to anyone who happened to be on it.
        "viewers": {
          ".read": false,
          ".write": false
        },

        "operators": {
          ".read": false,
          ".write": false
        },

        // The one write-capable subtree, and the odd one out: it drives a
        // physical VFD through the RH-W. Reading it is no more sensitive
        // than reading telemetry - it says "here is the last command and
        // whether the box confirmed it," not something worth hiding from a
        // viewer - so .read stays viewer-or-operator-or-admin, same as
        // latest/history/tags/status above. .write is the actual boundary:
        // moving equipment is what "operator, not viewer" is meant to gate,
        // so only operator or admin may write here. The validate rules below
        // are the box's actual protocol contract and are unchanged from
        // before this node moved here; only the write condition (was
        // authorized/{uid} from the very first, single-tier auth pass)
        // changed to match the real per-device model the rest of this file
        // already uses.
        "commands": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",

          // Closed shape: only these four keys, so a client cannot smuggle an
          // extra field the box's poller might one day be extended to trust.
          ".validate": "newData.hasChildren(['seq', 'value', 'issuedAt'])",

          "seq": {
            // Must increment by exactly one. The box treats an unchanged seq
            // as "nothing new" and a jump as grounds to distrust the sender,
            // so a client is only ever allowed to advance it by one step.
            ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() + 1 : newData.val() === 1)"
          },

          "value": {
            ".validate": "newData.val() === 1 || newData.val() === 6"
          },

          "issuedAt": {
            // Loosely bounded around the server clock. This is not the box's
            // 30-second staleness check - that is enforced on the box,
            // against whatever issuedAt the client sent, and this app must
            // never second-guess it. This band only catches a wildly wrong
            // client clock (or a forged timestamp) before it ever reaches
            // the box.
            ".validate": "newData.isNumber() && newData.val() <= now + 15000 && newData.val() >= now - 180000"
          },

          // ack/ is written by the box's Admin SDK, which bypasses every
          // rule here. The app writes commands with update(), touching only
          // seq, value and issuedAt, so a legitimate client request never
          // includes ack at all - an unconditional false is exactly the
          // right rule, not a stricter "must match" check.
          "ack": {
            ".validate": false
          },

          "$other": { ".validate": false }
        }
      }
    },

    // A session may always read its own index, whether or not it is
    // populated - this is what lets "no devices yet" render as a calm,
    // expected state rather than a failed read. auth.uid === $uid keeps it to
    // strictly one's own entry, never anyone else's.
    "access": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // Global, rare, grants every device - see the note at the top. A session
    // may read its own entry (same reasoning as access/$uid: the client needs
    // to know "am I an admin" to decide whether to show enabled VFD controls),
    // but never anyone else's - the full admin list is not something to leak
    // to every signed-in account.
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
