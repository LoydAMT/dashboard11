// Realtime Database security rules.
//
// Data flows one way: the logger's service account writes, clients read.
// The Admin SDK bypasses these rules entirely, so denying every client write
// here costs the pusher nothing and removes the whole class of "someone with
// the web config forged a reading" problems.
//
// Read requires a signed-in user. Today that is anonymous auth, which is a
// speed bump rather than a wall - anyone can mint an anonymous user. It keeps
// the database off the open internet and gives each session an identity to
// build on. Tighten the read conditions when real accounts land; the shape
// below is already per-subtree so that change stays local.
//
// history/ is queried with orderByKey(), which needs no .indexOn - keys are
// always indexed.
//
// commands/ is the one write-capable subtree, and it is the odd one out: it
// drives a physical VFD through the RH-W. TESTING PHASE - the write condition
// below is "auth != null", same speed bump as every read, so any anonymous
// session can command the drive. That is a deliberate, temporary choice for
// bench testing, matching src/auth.js#canControl. When real sign-in lands,
// both this condition and canControl must be tightened together - see the
// comment on canControl for what that change looks like. Until then, do not
// point this database at anything the anonymous-auth speed bump cannot be
// allowed to touch.
{
  "rules": {
    ".read": false,
    ".write": false,

    "latest": {
      ".read": "auth != null",
      ".write": false
    },

    "history": {
      ".read": "auth != null",
      ".write": false
    },

    "status": {
      ".read": "auth != null",
      ".write": false
    },

    "tags": {
      ".read": "auth != null",
      ".write": false
    },

    "commands": {
      "$device": {
        ".read": "auth != null",
        ".write": "auth != null",

        // Closed shape: only these four keys, so a client cannot smuggle an
        // extra field the box's poller might one day be extended to trust.
        ".validate": "newData.hasChildren(['seq', 'value', 'issuedAt'])",

        "seq": {
          // Must increment by exactly one. The box treats an unchanged seq as
          // "nothing new" and a jump as grounds to distrust the sender, so a
          // client is only ever allowed to advance it by one step.
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() + 1 : newData.val() === 1)"
        },

        "value": {
          ".validate": "newData.val() === 1 || newData.val() === 6"
        },

        "issuedAt": {
          // Loosely bounded around the server clock. This is not the box's
          // 30-second staleness check - that is enforced on the box, against
          // whatever issuedAt the client sent, and this app must never
          // second-guess it. This band only catches a wildly wrong client
          // clock (or a forged timestamp) before it ever reaches the box.
          ".validate": "newData.isNumber() && newData.val() <= now + 15000 && newData.val() >= now - 180000"
        },

        // ack/ is written by the box's Admin SDK, which bypasses every rule
        // here. The app writes commands with update(), touching only seq,
        // value and issuedAt, so a legitimate client request never includes
        // ack at all - an unconditional false is exactly the right rule, not
        // a stricter "must match" check. (An earlier version of this rule
        // required the client to echo ack back unchanged, on the assumption
        // that a whole-node write needed to preserve it - that broke the very
        // first command after a page load, when the client's cache had not
        // yet received the box's latest ack to echo. Switching the client to
        // update() removed the need for this rule to be anything other than
        // a flat no.)
        "ack": {
          ".validate": false
        },

        "$other": { ".validate": false }
      }
    }
  }
}
