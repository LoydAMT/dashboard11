// Realtime Database security rules.
//
// Data flows one way: the logger's service account writes, clients read.
// The Admin SDK bypasses these rules entirely, so denying every client write
// here costs the pusher nothing and removes the whole class of "someone with
// the web config forged a reading" problems.
//
// Multi-device model, all under devices/{deviceId}/. Access is per device,
// checked two ways at every gated node, both required:
//   1. auth.token.firebase.sign_in_provider !== 'anonymous' - not enough by
//      itself. Enabling the Email/Password provider (required for real
//      sign-in to work at all) also enables public self-registration through
//      the identical API, since the client's API key is not a secret - this
//      alone would let anyone who finds it create an account and pass.
//   2. That account is a viewer or operator of this specific device, or a
//      global admin. viewers/ and operators/ are admin-provisioned by hand
//      in the console and never written by the app. Viewer and operator are
//      equivalent for *reading* telemetry - both accepted identically below -
//      but not for commands/: writing to devices/{deviceId}/commands requires
//      operator or admin specifically, a viewer cannot. See that block.
//
// access/{uid}/{deviceId} is a separate, client-readable index of "which
// devices does this account see" - it exists only because Firebase cannot
// query "which devices list my uid" the other way around. It is navigation
// data, not a security decision: the rules below never reference it. It can
// in principle drift from devices/{deviceId}/viewers|operators (an admin
// mirrors both by hand); when it does, the rules below are what actually
// governs access, and the app is expected to treat the resulting
// PERMISSION_DENIED as a normal, handled state, not a crash.
//
// history/ is queried with orderByKey(), which needs no .indexOn - keys are
// always indexed.
{
  "rules": {
    ".read": false,
    ".write": false,

    "devices": {
      "$deviceId": {
        // A session may read its own membership check inputs implicitly via
        // the root.child() calls below; it never reads viewers/operators
        // directly (see those nodes' own rules further down).
        "latest": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": false
        },

        "history": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": false
        },

        "tags": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": false
        },

        "status": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": false
        },

        // Closed to the client both ways - admin-provisioned in the console
        // by hand, read only internally via root.child() from the rules
        // above. A client read here would leak the full member list of a
        // device to anyone who happened to be on it.
        "viewers": {
          ".read": false,
          ".write": false
        },

        "operators": {
          ".read": false,
          ".write": false
        },

        // The one write-capable subtree, and the odd one out: it drives a
        // physical VFD through the RH-W. Reading it is no more sensitive
        // than reading telemetry - it says "here is the last command and
        // whether the box confirmed it," not something worth hiding from a
        // viewer - so .read stays viewer-or-operator-or-admin, same as
        // latest/history/tags/status above. .write is the actual boundary:
        // moving equipment is what "operator, not viewer" is meant to gate,
        // so only operator or admin may write here. The validate rules below
        // are the box's actual protocol contract and are unchanged from
        // before this node moved here; only the write condition (was
        // authorized/{uid} from the very first, single-tier auth pass)
        // changed to match the real per-device model the rest of this file
        // already uses.
        "commands": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",

          // Closed shape: only these four keys, so a client cannot smuggle an
          // extra field the box's poller might one day be extended to trust.
          ".validate": "newData.hasChildren(['seq', 'value', 'issuedAt'])",

          "seq": {
            // Must increment by exactly one. The box treats an unchanged seq
            // as "nothing new" and a jump as grounds to distrust the sender,
            // so a client is only ever allowed to advance it by one step.
            ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() + 1 : newData.val() === 1)"
          },

          "value": {
            ".validate": "newData.val() === 1 || newData.val() === 6"
          },

          "issuedAt": {
            // Loosely bounded around the server clock. This is not the box's
            // 30-second staleness check - that is enforced on the box,
            // against whatever issuedAt the client sent, and this app must
            // never second-guess it. This band only catches a wildly wrong
            // client clock (or a forged timestamp) before it ever reaches
            // the box.
            ".validate": "newData.isNumber() && newData.val() <= now + 15000 && newData.val() >= now - 180000"
          },

          // ack/ is written by the box's Admin SDK, which bypasses every
          // rule here. The app writes commands with update(), touching only
          // seq, value and issuedAt, so a legitimate client request never
          // includes ack at all - an unconditional false is exactly the
          // right rule, not a stricter "must match" check.
          "ack": {
            ".validate": false
          },

          "$other": { ".validate": false }
        }
      }
    },

    // A session may always read its own index, whether or not it is
    // populated - this is what lets "no devices yet" render as a calm,
    // expected state rather than a failed read. auth.uid === $uid keeps it to
    // strictly one's own entry, never anyone else's.
    "access": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // Global, rare, grants every device - see the note at the top. A session
    // may read its own entry (same reasoning as access/$uid: the client needs
    // to know "am I an admin" to decide whether to show enabled VFD controls),
    // but never anyone else's - the full admin list is not something to leak
    // to every signed-in account.
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // Grouping layer. companies/ is the SOURCE OF TRUTH for who may see
    // what; a Cloud Function (projectCompanyAccess) mirrors it down into
    // devices/{deviceId}/viewers|operators and access/{uid}, which is what
    // the rules above actually enforce. Telemetry does NOT move - a company
    // is a set of devices plus a set of members, nothing more.
    //
    // Why a projection rather than reading companies/ directly in the rules
    // above: a rule cannot iterate "every company that contains this device
    // and lists me". It can only do direct lookups. So the fan-out is done
    // once, by a function, into the flat shape a lookup can reach.
    //
    // This is also what ends the drift the comment at the top of this file
    // warns about: access/ and viewers|operators are now written by the same
    // machine from the same source, rather than mirrored by hand.
    // An admin may list every company; a member may read only their own.
    //
    // Membership deliberately does NOT live here. In Realtime Database a
    // .read grant CASCADES to the whole subtree and a child ".read": false
    // cannot revoke it - so the moment admins could list companies/, a
    // members child would be exposed with it. Keeping members in their own
    // top-level node is what makes "admins can see the company list" and
    // "nobody can enumerate another company's people" both true.
    "companies": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$companyId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('companyMembers/'+$companyId+'/'+auth.uid).exists()",
        ".write": false
      }
    },

    // Closed both ways to every client, same reasoning as
    // devices/{id}/viewers: a member list leaks every colleague's uid to
    // anyone on the company. Read internally by the rules above via
    // root.child(), and written only by the Admin SDK.
    "companyMembers": {
      ".read": false,
      ".write": false
    },

    // "which companies am I in" - the same kind of navigation index as
    // access/{uid}, and readable on exactly the same terms: your own entry
    // only, whether or not it is populated, so "no companies yet" renders
    // as a calm empty state rather than a failed read.
    "userCompanies": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // Alert thresholds: alertRules/{deviceId}/{tagKey} = { hi, lo }.
    //
    // NOTHING IS ENFORCED BY THESE. They decide when a notification fires.
    // No supply is switched, cut or restricted anywhere in this system - the
    // boxes read meters, they do not control load.
    //
    // Deliberately NOT stored under devices/{deviceId}/tags, even though
    // that is where a tag's other metadata lives: the box rewrites its own
    // tags/ node on every push_meta(), so anything kept alongside it would
    // be erased on the next reboot. These are server-owned and the device
    // never sees them.
    //
    // Admin-only both ways. A threshold decides whether an alarm fires at all,
    // so setting one is an operational act, not a preference - and reading
    // the list would tell any signed-in account what every other tenant's
    // thresholds are.
    //
    // Only `hi` and `lo` are accepted, and only as numbers. The spike
    // detector needs no configuration and is not represented here; it fires
    // on a reading far outside a tag's own recent range, whether or not a
    // fixed threshold exists.
    "alertRules": {
      // Admin-wide read: lets the admin page list every device's thresholds
      // in one place. A .read CASCADES in this database, so this grant alone
      // would be the whole story - the per-device grant below can only ADD
      // to it, never take away from it.
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$deviceId": {
        // A tenant reads the thresholds for devices they can already see,
        // and nothing else. This is what lets the gauge on a tag card draw
        // its alert zones: without it the card cannot know where the zones
        // are and falls back to a scale inferred from recent readings.
        //
        // It leaks nothing across tenants - the condition is the same
        // viewer-or-operator-or-admin test that already governs the
        // telemetry itself, so it says only "you may see the alert levels
        // for a meter whose readings you may already see".
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",

        "$tagKey": {
          ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",

          // A low threshold at or above the high one would put every reading
          // simultaneously over and under, which is not a state the alert
          // engine can report usefully. Rejected here rather than left to
          // be discovered from a confusing alert log.
          ".validate": "!(newData.hasChild('hi') && newData.hasChild('lo')) || newData.child('lo').val() < newData.child('hi').val()",

          "hi": { ".validate": "newData.isNumber()" },
          "lo": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    // A display-name override for a device, shared with everyone who can see
    // it - deliberately not device data itself (devices/{deviceId} is
    // untouched by this) and not per-browser: this exists so a rename shows
    // up for every signed-in account, not just the one who set it. Read
    // follows the same viewer-or-operator-or-admin access as the device
    // itself - knowing its friendly name is no more sensitive than seeing
    // its telemetry.
    //
    // Write is intentionally NOT a role in the access model: one specific
    // account, hardcoded. This is a personal labeling tool for that account
    // rather than a capability meant to be handed to operators or admins
    // generally - being an admin does not make renaming someone else's
    // device your business. (Matches the client-side gate in
    // components/NamingPage.jsx - that check is for the page's UI, this
    // rule is the actual boundary.)
    "naming": {
      "$deviceId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (root.child('devices/'+$deviceId+'/viewers/'+auth.uid).val() === true || root.child('devices/'+$deviceId+'/operators/'+auth.uid).val() === true || root.child('admins/'+auth.uid).val() === true)",
        ".write": "auth.uid === 'ROz1Xq3b4yReAPkLNGJCFbj6inV2'",
        // Either a real, short label, or the key is being removed entirely
        // (clearing the override, back to showing the raw id) - an empty
        // string is deliberately not a valid stored value, so "cleared" and
        // "set to nothing" can never be ambiguous.
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 60)"
      }
    }
  }
}
